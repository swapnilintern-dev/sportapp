<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only. Android blocks plain http by default, which stops a
         phone on the office wifi from reaching a SPOCART API running on a
         laptop (http://192.168.x.x:3000). Release builds never see this file,
         so the shipped app still refuses anything but https. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
